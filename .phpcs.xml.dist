<?xml version="1.0"?>
<ruleset name="Ultimate Crypto Widget">
	<description>PSR-12 style plus WordPress's safety sniffs: the same rules as WPToolkit, the library this plugin is built on.</description>

	<file>src</file>
	<file>views</file>
	<file>ultimate-crypto-widget.php</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="tab-width" value="4"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.5"/>
	<!-- Warnings (a long line of translatable text) are shown but do not fail the check. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<!--
		Style: PSR-12, indented with tabs as WordPress code is.

		Not applied to the main file and src/boot.php (WordPress-style; the main file is PHP 5.6 on
		purpose, so it parses on an old server and can say so) or to views (templates).
	-->
	<rule ref="PSR12">
		<exclude name="Generic.WhiteSpace.DisallowTabIndent"/>
		<!-- Git normalises line endings; a Windows checkout has CRLF on disk. -->
		<exclude name="Generic.Files.LineEndings"/>
		<exclude-pattern>ultimate-crypto-widget\.php$</exclude-pattern>
		<exclude-pattern>*/views/*</exclude-pattern>
		<exclude-pattern>*/src/boot\.php$</exclude-pattern>
	</rule>
	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<properties>
			<property name="indent" value="4"/>
			<property name="tabIndent" value="true"/>
		</properties>
		<exclude-pattern>*/views/*</exclude-pattern>
	</rule>

	<!--
		Translatable text must be one string literal (WordPress.WP.I18n), so a long sentence
		cannot be wrapped.
	-->
	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="200"/>
			<property name="absoluteLineLimit" value="0"/>
		</properties>
		<exclude-pattern>*/views/*</exclude-pattern>
	</rule>

	<!-- Elementor decides these method names (get_name, register_controls, …). -->
	<rule ref="PSR1.Methods.CamelCapsMethodName">
		<exclude-pattern>*/src/Integrations/Elementor/*</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- The parts of the WordPress standard that catch real bugs: escaping, nonces, input, SQL, i18n. -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ultimate-crypto-widget"/>
			</property>
		</properties>
	</rule>

	<!-- Exception messages go to logs and developers, never to a page as they are. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>
</ruleset>
